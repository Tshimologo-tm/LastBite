<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8EE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#285943" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Give your leftovers a second chance."
            android:textSize="16sp"
            android:textColor="#59665D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:labelFor="@id/edtIngredientName"
            android:text="Ingredient name"
            android:textSize="16sp"
            android:textColor="#253A2E" />

        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="e.g. Rice"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:maxLines="1"
            android:textColor="#253A2E"
            android:textColorHint="#59665D"
            android:backgroundTint="#285943" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/edtQuantity"
            android:text="Quantity"
            android:textSize="16sp"
            android:textColor="#253A2E" />

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="e.g. 500"
            android:inputType="numberDecimal"
            android:maxLength="12"
            android:maxLines="1"
            android:textColor="#253A2E"
            android:textColorHint="#59665D"
            android:backgroundTint="#285943" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/spinnerUnit"
            android:text="Unit"
            android:textSize="16sp"
            android:textColor="#253A2E" />

        <Spinner
            android:id="@+id/spinnerUnit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Save Ingredient"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#285943" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#59665D" />

    </LinearLayout>
</ScrollView>