<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8EE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last Bite"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#285943" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Less waste. More taste."
            android:textSize="16sp"
            android:textColor="#59665D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="My Pantry"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#253A2E" />

        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="+ Add Ingredient"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#285943" />

        <TextView
            android:id="@+id/txtEmptyPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:gravity="center"
            android:text="Your pantry is empty. Add your first ingredient!"
            android:textSize="16sp"
            android:textColor="#59665D" />

        <TextView
            android:id="@+id/txtPantryTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="Tip: Tap an ingredient to edit it. Press and hold to delete it. Keep quantities updated for accurate recipe suggestions."
            android:textColor="#59665D"
            android:textSize="14sp" />

        <ListView
            android:id="@+id/listPantry"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#DDDCD2"
            android:dividerHeight="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRecipes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cook Now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#285943" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#59665D" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>